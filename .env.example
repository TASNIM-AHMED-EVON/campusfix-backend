# Copy this file to ".env" and fill in real values. Never commit ".env".

# Primary database (Supabase). Use the pooler connection string if your host cannot reach the direct one.
DB_URL=jdbc:postgresql://localhost:5432/campusfix
DB_USERNAME=campusfix
DB_PASSWORD=change_me

# Server
PORT=8080

# Allowed frontend origin (Netlify URL in production) - used in a later step
CORS_ALLOWED_ORIGIN=http://localhost:5173
